---
import '../styles/global.css';

const pageTitle = "About Rusty World";

const whoAmI = {
    firstName: "Burak Selim",
    lastName: "Şenyurt",
    country: "Somewhere in the Atlantic Ocean",
    occupation: "Computer Programmer",
    hobbies: ["Programming", "Reading", "Writing", "Photography", "Legoing"],
};

const skills = ["Rust", "C#", "Java", "OCaml", "Zig"];

const skillColor = "indianred";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <style define:vars={{ skillColor, fontWeight, textCase }}>
            h1 {
                color: crimson;
                font-size: 4rem;
            }
            .skill {
                color: var(--skillColor);
                font-weight: var(--fontWeight);
                text-transform: var(--textCase);
            }
        </style>
        <title>{pageTitle}</title>
    </head>
    <body>
        <a href="/">Home</a><br />
        <a href="/about/">{pageTitle}</a><br />
        <a href="/blog/">Blog</a><br />

        <h1>About This Blog</h1>
        <h2>... or why this blog exists?</h2>
        <p>
            This blog was created to share articles and information about the
            Rust programming language. Rust is known as a safe and fast systems
            programming language, and this blog aims to cover various topics
            related to Rust.
        </p>
        <h2>Target Audience</h2>
        <p>
            This blog is designed for developers, students, and technology
            enthusiasts interested in the Rust programming language. Anyone
            looking to learn about Rust can benefit from this blog.
        </p>

        <p>Here are a few facts about me:</p>
        <ul>
            <li>My name is {whoAmI.firstName} {whoAmI.lastName}.</li>
            <li>I live in {whoAmI.country}.</li>
            <li>My occupation is {whoAmI.occupation}.</li>
            {
                whoAmI.hobbies.length >= 2 && (
                    <li>
                        Two of my hobbies are: {whoAmI.hobbies[0]} and{" "}
                        {whoAmI.hobbies[1]}
                    </li>
                )
            }
        </ul>
        <p>My skills are:</p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
    </body>
</html>
