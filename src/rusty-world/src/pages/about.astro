---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Rusty World";

const whoAmI = {
    firstName: "Burak Selim",
    lastName: "Şenyurt",
    country: "Somewhere in the Atlantic Ocean",
    occupation: "Computer Programmer",
    hobbies: ["Programming", "Reading", "Writing", "Photography", "Legoing"],
};

const skills = ["Rust", "C#", "Java", "OCaml", "Zig"];
---

<BaseLayout pageTitle={pageTitle}>
    <p>
        This blog was created to share articles and information about the Rust
        programming language. Rust is known as a safe and fast systems
        programming language, and this blog aims to cover various topics related
        to Rust.
    </p>
    <h2>Target Audience</h2>
    <p>
        This blog is designed for developers, students, and technology
        enthusiasts interested in the Rust programming language. Anyone looking
        to learn about Rust can benefit from this blog.
    </p>

    <h2>Here are a few facts about me:</h2>
    <ul>
        <li>My name is {whoAmI.firstName} {whoAmI.lastName}.</li>
        <li>I live in {whoAmI.country}.</li>
        <li>My occupation is {whoAmI.occupation}.</li>
        {
            whoAmI.hobbies.length >= 2 && (
                <li>
                    Two of my hobbies are: {whoAmI.hobbies[0]} and{" "}
                    {whoAmI.hobbies[1]}
                </li>
            )
        }
    </ul>
    <p>My skills are:</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
</BaseLayout>
